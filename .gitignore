# ==========================================
# HireHub - Full Stack Application
# Root .gitignore
# ==========================================

# Environment variables
.env
.env.*
*.env

# Frontend - Node / Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend - Maven / Java
backend/target/
backend/*.jar
backend/*.war

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache / temporary files
.cache/
*.tmp
*.temp